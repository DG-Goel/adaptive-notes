# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=tutor_knowledge

# Groq API (Required - Get key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=30

# LLM Provider Selection
LLM_PROVIDER=mock  # Options: "mock" (testing) or "groq" (production)

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512

# Reranker Model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16

# Retrieval Configuration
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_K=5

# Generation Configuration
GENERATION_TEMPERATURE_STRICT=0.3
GENERATION_TEMPERATURE_TEACHING=0.5
GENERATION_MAX_TOKENS=800
GENERATION_TOP_P=0.9
GENERATION_FREQUENCY_PENALTY=0.3

# Chunking Configuration
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=100
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50
CHILD_CHUNK_MIN=256
CHILD_CHUNK_MAX=480

# Performance
EMBEDDING_CACHE_SIZE=10000
CONVERSATION_CACHE_SIZE=1000
CONVERSATION_TTL_SECONDS=3600

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1
