      "label": "User lookup"
    },
    {
      "from": "backend",
      "to": "database",
      "label": "SQL",
      "bidirectional": true
    },
    {
      "from": "backend",
      "to": "cache",
      "label": "Cache",
      "bidirectional": true
    },
    {
      "from": "backend",
      "to": "storage",
      "label": "Files",
      "bidirectional": true
    },
    {
      "from": "backend",
      "to": "monitoring",
      "label": "Telemetry"
