# Server-only configuration. This file is NOT auto-loaded.
NOETRA_INFOGRAPHIC_ENGINE_ENABLED=false
GEMINI_PLANNER_API_KEY=
GEMINI_GENERATOR_API_KEY=
GEMINI_VERIFIER_API_KEY=

# Repeat these independent settings with GENERATOR and VERIFIER prefixes.
NOETRA_INFOGRAPHIC_PLANNER_MODEL=gemma-4-31b-it
NOETRA_INFOGRAPHIC_PLANNER_REQUESTS_PER_MINUTE=5
NOETRA_INFOGRAPHIC_PLANNER_TOKENS_PER_MINUTE=32000
NOETRA_INFOGRAPHIC_PLANNER_CONTEXT_TOKENS=16000
NOETRA_INFOGRAPHIC_PLANNER_MAX_OUTPUT_TOKENS=2000
NOETRA_INFOGRAPHIC_PLANNER_CONCURRENCY=1
NOETRA_INFOGRAPHIC_PLANNER_MAX_ATTEMPTS=2
NOETRA_INFOGRAPHIC_PLANNER_RETRY_SECONDS=2
NOETRA_INFOGRAPHIC_PLANNER_TIMEOUT_SECONDS=60
