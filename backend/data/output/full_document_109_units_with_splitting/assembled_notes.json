          "document_id": "full_document",
          "knowledge_type": "fact",
          "primary_format": "standard_text",
          "format_content": {
            "content": "She instituted a family custom of telling dreams before breakfast."
          },
          "secondary_format": null,
          "secondary_content": null,
          "selection_confidence": 0.2,
          "confidence_label": "fallback",
          "selection_reasoning": "Fallback format",
