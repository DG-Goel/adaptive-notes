          "evidence": [
            {
              "note_id": "FCT_0073",
              "quote": "people's expectations about future exchange rates move exchanges a lot"
            },
            {
              "note_id": "CON_0020",
              "quote": "we're going to assume for now that the expected exchange rate for t plus 1 is fixed"
            },
            {
              "note_id": "CON_0021",
              "quote": "we all have a common spectral exchange rate, and it's fixed"
            },
            {
              "note_id": "FCT_0072",
              "quote": "the simplification of assuming a fixed expected exchange rate is completely unrealistic"
            },
            {
              "note_id": "FCT_0074",
              "quote": "An increase in the domestic interest rate, other things equal, appreciates the exchange rate."
            },
            {
              "note_id": "CON_0026",
              "quote": "Increasing the interest rate causes the exchange rate to appreciate."
            },
            {
              "note_id": "FCT_0075",
              "quote": "If the domestic interest rate is increased while the foreign rate stays the same, the exchange rate will appreciate."
            },
            {
              "note_id": "FCT_0076",
              "quote": "When domestic and foreign interest rates are equal, there is no expected capital gain or loss from holding the currency."
            },
            {
              "note_id": "FCT_0077",
              "quote": "the exchange rate is depreciating"
            },
            {
              "note_id": "FCT_0078",
              "quote": "the dollar is depreciating"
            },
            {
              "note_id": "FCT_0079",
              "quote": "the exchange rate will fall"
            },
            {
              "note_id": "CON_0032",
              "quote": "When the exchange rate falls, the domestic currency is said to be depreciating."
            },
            {
              "note_id": "CON_0029",
              "quote": "When one bond pays a higher interest than another, the higher return must be offset by an expected depreciation of the currency of the higher‑interest bond."
            },
            {
              "note_id": "CON_0030",
              "quote": "The anticipated loss in value of a currency that is expected to depreciate, used to offset a higher interest rate on a bond denominated in that currency."
            },
            {
              "note_id": "CON_0031",
              "quote": "when I fix the expected exchange rate, the only way I can do that is by appreciating the currency today so I can expect it to depreciate in the future."
            }
          ],
