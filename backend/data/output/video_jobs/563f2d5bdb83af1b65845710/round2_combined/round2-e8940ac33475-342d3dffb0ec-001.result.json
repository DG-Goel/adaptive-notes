            },
            {
              "note_id": "CON_0019",
              "exact_quote": "Compensate the interest rate differential with an expected depreciation of the currency that is paying a higher interest rate."
            },
            {
              "note_id": "CON_0023",
              "exact_quote": "If the domestic interest rate is above the international interest rate, the exchange rate today must be above the expected exchange rate, because the expected depreciation of the currency compensates for the higher domestic interest rate."
            }
          ],
