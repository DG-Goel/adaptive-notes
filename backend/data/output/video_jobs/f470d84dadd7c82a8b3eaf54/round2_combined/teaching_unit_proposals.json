            "note_id": "CON_0002",
            "exact_quote": "the relative price of domestic goods versus foreign goods, expressed in a common currency"
          },
          {
            "note_id": "FCT_0002",
            "exact_quote": "UK bond offers a 10 percent interest rate. US bond offers a 5 percent interest rate."
          },
          {
            "note_id": "FCT_0003",
            "exact_quote": "If I go the UK bond route, I get 10% in return in the bond, minus 5% in the capital loss due to the appreciation of the dollar."
          },
          {
            "note_id": "FCT_0004",
            "exact_quote": "So net I get 5% as well."
          },
          {
            "note_id": "FCT_0049",
            "exact_quote": "So I divide this by the expected exchange rate it next year, and then I get that's my return in dollars of having gone the UK bond route."
          }
