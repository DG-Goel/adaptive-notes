          "semantic_entailment_verified": false,
          "evidence": [
            {
              "source_id": "G00037",
              "quote": "So these two variables\n are not independent of each other, they're referencing the same object,\n and that means, if I update this point object through either of these variables,\n the changes will be visible to the other variable.",
              "fields": [
