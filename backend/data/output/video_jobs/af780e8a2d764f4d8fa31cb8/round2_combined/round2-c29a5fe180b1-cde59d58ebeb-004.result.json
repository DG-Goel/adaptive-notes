          ],
          "needs_review": false,
          "missing_information": [],
          "evidence": [
            {
              "note_id": "CON_0032",
              "exact_quote": "The expected exchange rate is treated as an exogenous parameter that is not endogenized."
            },
            {
              "note_id": "FCT_0074",
              "exact_quote": "If we expect the dollar to appreciate in the future, it appreciates today. Moving the expected exchange rate up causes the current exchange rate to rise immediately. Fixing the expected exchange rate prevents it from becoming an endogenous variable."
            }
          ],
          "payload": {
            "type": "concept_tree",
            "title": "Expected Exchange Rate Parameter",
            "nodes": [
