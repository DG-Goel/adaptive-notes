              },
              {
                "id": "e2",
                "label": "If expected to appreciate → current rate rises",
                "parent": "e0"
              },
              {
                "id": "e3",
                "label": "Fixing it prevents endogeneity",
                "parent": "e0"
              }
            ]
          }
