  "teaching_units": [
    {
      "title": "Interest Rate Differential and Expected Currency Depreciation",
      "source_segment_ids": [
        "CON_0026",
        "EXP_0003",
        "CON_0025"
      ],
      "mode": "visual_only",
      "remaining_text": null,
      "visuals": [
        {
          "source_segment_ids": [
            "CON_0026",
            "EXP_0003",
            "CON_0025"
          ],
          "needs_review": false,
          "missing_information": [],
          "evidence": [
            {
              "note_id": "CON_0026",
              "exact_quote": "The anticipated fall in the value of a currency that is used to offset a higher interest rate on a bond denominated in that currency."
            },
            {
              "note_id": "EXP_0003",
              "exact_quote": "So if I am now telling you that one bond is paying a higher interest than the other one, I need to offset that somehow."
            },
            {
              "note_id": "EXP_0003",
              "exact_quote": "How do I offset it by expecting a depreciation of the bond that is denominated in the currency that is expected to depreciate?"
            },
            {
              "note_id": "EXP_0003",
              "exact_quote": "So what I need to do is compensate say, for the interest rate differential with an expected depreciation of the currency that's paying a higher interest rate."
            },
            {
              "note_id": "CON_0025",
              "exact_quote": "When one bond pays a higher interest rate than another, the higher return must be offset by an expected depreciation of the currency of the higher‑interest bond."
            }
          ],
          "payload": {
            "type": "concept_tree",
            "title": "Interest Rate Differential → Expected Depreciation",
            "nodes": [
              {
                "id": "n0",
                "label": "Interest Rate Differential"
              },
              {
                "id": "n1",
                "label": "Higher‑interest bond",
                "parent": "n0"
              },
              {
                "id": "n2",
                "label": "Expected depreciation of its currency",
                "parent": "n0",
                "description": "Used to offset the higher interest"
              }
            ]
          }
        }
      ]
    },
