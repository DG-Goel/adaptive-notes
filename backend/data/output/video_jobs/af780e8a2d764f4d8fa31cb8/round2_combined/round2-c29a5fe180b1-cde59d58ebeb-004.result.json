    {
      "title": "Expected Exchange Rate as an Exogenous Parameter",
      "source_segment_ids": [
        "CON_0032",
        "FCT_0074"
      ],
      "mode": "visual_only",
      "remaining_text": null,
      "visuals": [
        {
          "source_segment_ids": [
