          },
          {
            "note_id": "CON_0011",
            "exact_quote": "A short‑run macroeconomic model that fixes nominal prices and analyzes the interaction of the goods market (IS) and money market (LM)."
          },
          {
            "note_id": "CON_0012",
            "exact_quote": "Net exports is a term added to the model representing the difference between exports and imports, functioning as a component of demand."
          },
          {
            "note_id": "CON_0014",
            "exact_quote": "Net exports increase when foreign (rest‑of‑the‑world) income rises and decline when the real exchange rate rises."
          }
        ],
