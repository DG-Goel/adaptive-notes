    {
      "title": "Interest Rate Differential and Expected Depreciation",
      "source_segment_ids": [
        "CON_0025",
        "CON_0026",
        "EXP_0003",
        "EXP_0004"
      ],
      "mode": "visual_only",
      "remaining_text": null,
      "visuals": [
        {
          "source_segment_ids": [
            "CON_0025",
            "CON_0026",
            "EXP_0003",
            "EXP_0004"
          ],
          "needs_review": false,
          "missing_information": [],
          "evidence": [
            {
              "note_id": "CON_0025",
              "exact_quote": "When one bond pays a higher interest rate than another, the higher return must be offset by an expected depreciation of the currency of the higher‑interest bond."
            },
            {
              "note_id": "CON_0026",
              "exact_quote": "The anticipated fall in the value of a currency that is used to offset a higher interest rate on a bond denominated in that currency."
            },
            {
              "note_id": "EXP_0003",
              "exact_quote": "So what I need to do is compensate say, for the interest rate differential with an expected depreciation of the currency that's paying a higher interest rate."
            },
            {
              "note_id": "EXP_0004",
              "exact_quote": "When the currency appreciates enough, the higher‑interest advantage disappears because the expected depreciation component is reduced."
            }
          ],
          "payload": {
