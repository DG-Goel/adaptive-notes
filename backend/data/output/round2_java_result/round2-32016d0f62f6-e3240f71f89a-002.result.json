          ],
          "needs_review": false,
          "missing_information": null,
          "evidence": [
            {
              "note_id": "FCT_0066",
              "exact_quote": "Compiling a Java source file produces a `.class` file (e.g., main.class) that contains the bytecode representation of the source."
            },
            {
              "note_id": "FCT_0067",
              "exact_quote": "When running a Java program from an IDE (e.g., IntelliJ), the generated `.class` files are stored in a separate output folder, not alongside the source files."
            },
            {
              "note_id": "FCT_0068",
              "exact_quote": "The compiled `.class` file resides in the package directory structure (e.g., `helloWorld/com/codewithmosh/main.class`)."
            },
            {
              "note_id": "FCT_0069",
              "exact_quote": "Java bytecode is platform‑independent; the same `.class` file can run on Windows, macOS, Linux, or any OS with a Java Runtime Environment (JRE)."
            },
            {
              "note_id": "FCT_0070",
              "exact_quote": "The Java Runtime Environment includes the Java Virtual Machine (JVM), which translates Java bytecode to native code for the underlying operating system."
            },
            {
              "note_id": "FCT_0072",
              "exact_quote": "To run a Java program you invoke the Java virtual machine (JVM) by typing `java` followed by the full path to the main class file."
            },
            {
              "note_id": "FCT_0074",
              "exact_quote": "When the `java` command is executed, the JVM searches the folder hierarchy for the specified package and class, loads the bytecode, and converts it to native code for the operating system."
            }
          ],
