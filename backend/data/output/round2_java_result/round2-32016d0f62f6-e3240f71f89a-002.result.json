          "evidence": [
            {
              "note_id": "FCT_0081",
              "exact_quote": "In Java, a variable is declared with a type, a name, and an initial value, e.g., int age = 30."
            },
            {
              "note_id": "FCT_0083",
              "exact_quote": "When declaring a variable, you first specify its type and then give it a name (identifier)."
            },
            {
              "note_id": "FCT_0084",
              "exact_quote": "The equal sign (=) is the assignment operator that assigns a value to a variable."
            },
            {
              "note_id": "FCT_0085",
              "exact_quote": "Initializing a variable means giving it an initial value."
            }
          ],
