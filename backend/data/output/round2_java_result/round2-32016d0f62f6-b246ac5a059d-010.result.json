          "evidence": [
            {
              "note_id": "FCT_0332",
              "exact_quote": "The && operator represents the logical AND operator in Java."
            },
            {
              "note_id": "FCT_0333",
              "exact_quote": "If both conditions are true, the result of the boolean expression is true; otherwise it is false."
            },
            {
              "note_id": "FCT_0334",
              "exact_quote": "Java evaluates a boolean expression from left to right and uses short‑circuit evaluation: if the first condition is false, the second condition is not evaluated."
            }
          ],
