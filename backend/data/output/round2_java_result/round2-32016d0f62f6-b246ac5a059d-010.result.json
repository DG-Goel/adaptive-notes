          "missing_information": null,
          "evidence": [
            {
              "note_id": "FCT_0365",
              "exact_quote": "Switch statements execute different parts of code depending on the value of an expression, kind of similar to if statements."
            },
            {
              "note_id": "FCT_0368",
              "exact_quote": "If we didn't use this break statement here, Java will continue executing these other lines here."
            },
            {
              "note_id": "FCT_0369",
              "exact_quote": "A default clause in a switch statement executes when none of the previous case clauses match."
            },
            {
              "note_id": "FCT_0370",
              "exact_quote": "A break statement is not required after the last case in a switch block because execution automatically exits the block."
            }
          ],
