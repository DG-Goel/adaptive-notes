          "needs_review": false,
          "missing_information": null,
          "evidence": [
            {
              "note_id": "FCT_0339",
              "exact_quote": "An if‑else‑if chain can have three clauses: the initial if, one or more else if, and an optional else."
            },
            {
              "note_id": "FCT_0342",
              "exact_quote": "If the first condition of an if‑else chain is false, the program proceeds to evaluate the next else if condition."
            },
            {
              "note_id": "FCT_0340",
              "exact_quote": "When removing unnecessary braces, align else if and else clauses at the same indentation level as the if clause for better readability."
            }
          ],
