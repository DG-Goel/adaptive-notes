    {
      "title": "Numeric Type Casting Hierarchy",
      "source_segment_ids": [
        "FCT_0219",
        "FCT_0220",
        "FCT_0221",
        "FCT_0224",
        "FCT_0225",
        "FCT_0226"
      ],
      "mode": "visual_only",
      "remaining_text": null,
      "visuals": [
        {
          "source_segment_ids": [
            "FCT_0219",
            "FCT_0220",
            "FCT_0221",
            "FCT_0224",
            "FCT_0225",
            "FCT_0226"
          ],
          "needs_review": false,
          "missing_information": null,
          "evidence": [
            {
              "note_id": "FCT_0219",
              "exact_quote": "When a short is used in an expression with an int, Java implicitly casts the short to an int."
            },
            {
              "note_id": "FCT_0220",
              "exact_quote": "Byte can be automatically converted to short, short to int, int to long, and so on up the numeric hierarchy."
            },
            {
              "note_id": "FCT_0221",
              "exact_quote": "Implicit casting occurs automatically when converting a value to a larger numeric type without loss of data."
            },
            {
              "note_id": "FCT_0224",
              "exact_quote": "When an int is added to a double, the int is implicitly cast to double before the addition."
            },
            {
              "note_id": "FCT_0225",
              "exact_quote": "Explicit casting is required when converting from a larger numeric type to a smaller one (e.g., double to int)."
            },
            {
              "note_id": "FCT_0226",
              "exact_quote": "Explicit casting can only be performed between compatible primitive numeric types."
            }
          ],
          "payload": {
            "type": "table",
            "title": "Implicit and Explicit Casting in Java",
            "headers": [
              "From Type",
              "To Type",
              "Casting Mode",
              "Notes"
