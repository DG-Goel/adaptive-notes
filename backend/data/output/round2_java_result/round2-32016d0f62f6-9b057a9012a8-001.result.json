    {
      "title": "Java Class‑Method Architecture",
      "source_segment_ids": [
        "FCT_0040",
        "FCT_0041",
        "FCT_0043",
        "FCT_0045",
        "FCT_0047"
      ],
      "mode": "text_and_visual",
      "remaining_text": "",
      "visuals": [
        {
          "source_segment_ids": [
            "FCT_0040",
            "FCT_0041",
            "FCT_0043",
            "FCT_0045",
            "FCT_0047"
          ],
          "needs_review": false,
          "missing_information": null,
          "evidence": [
            {
              "note_id": "FCT_0040",
              "exact_quote": "Functions in Java must belong to a class; they cannot exist on their own."
            },
            {
              "note_id": "FCT_0041",
              "exact_quote": "A class is a container for one or more related functions (methods) and is used to organize code."
            },
            {
              "note_id": "FCT_0043",
              "exact_quote": "Every Java program should have at least one class that contains the main function."
            },
            {
              "note_id": "FCT_0045",
              "exact_quote": "Functions defined inside a class are called methods."
            },
            {
              "note_id": "FCT_0047",
              "exact_quote": "A Java program must contain a main class and inside this main class we have the main method."
            }
          ],
          "payload": {
            "type": "architecture",
            "title": "Class‑Method Relationship",
            "direction": "left-to-right",
            "components": [
              {
                "id": "c1",
                "label": "Class"
              },
              {
                "id": "c2",
                "label": "Method (e.g., main)"
              }
            ],
            "connections": [
              {
                "from": "c1",
                "to": "c2",
                "label": "contains"
              }
            ]
          }
        }
      ]
