          "evidence": [
            {
              "note_id": "FCT_0122",
              "exact_quote": "Assigning a primitive variable copies the actual value into a new memory location; assigning a reference variable copies the address, not the object itself."
            },
            {
              "note_id": "FCT_0125",
              "exact_quote": "Reference types are copied by reference, whereas primitive types are copied by value."
            },
            {
              "note_id": "FCT_0119",
              "exact_quote": "In other words, if I change the value of x, y is not going to get affected."
            }
          ],
