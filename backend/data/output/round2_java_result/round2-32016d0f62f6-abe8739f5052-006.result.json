    {
      "title": "Operator Precedence in Java Expressions",
      "source_segment_ids": [
        "FCT_0206",
        "FCT_0207",
        "FCT_0209",
        "FCT_0208"
      ],
      "mode": "visual_only",
      "remaining_text": null,
      "visuals": [
        {
          "source_segment_ids": [
            "FCT_0206",
            "FCT_0207",
            "FCT_0209",
            "FCT_0208"
          ],
          "needs_review": false,
          "missing_information": null,
          "evidence": [
            {
              "note_id": "FCT_0206",
              "exact_quote": "Multiplication and division have higher precedence than addition and subtraction."
            },
            {
              "note_id": "FCT_0207",
              "exact_quote": "In the expression 10 + 3 * 2, the multiplication is evaluated first (3 * 2 = 6) and then added to 10, yielding 16."
            },
            {
              "note_id": "FCT_0209",
              "exact_quote": "Parentheses always have the highest priority, then multiplication and division, and finally addition and subtraction."
            },
            {
              "note_id": "FCT_0208",
              "exact_quote": "Now if you want to change the order of these operators, you can always use parenthesis."
            }
          ],
