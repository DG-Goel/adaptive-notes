    {
      "title": "Postfix vs Prefix Increment Operators",
      "source_segment_ids": [
        "FCT_0202",
        "FCT_0203"
      ],
      "mode": "visual_only",
      "remaining_text": null,
      "visuals": [
        {
          "source_segment_ids": [
            "FCT_0202",
            "FCT_0203"
          ],
          "needs_review": false,
          "missing_information": null,
          "evidence": [
            {
              "note_id": "FCT_0202",
              "exact_quote": "When the increment operator is used as a postfix (x++), the original value of x is used in the expression and then x is incremented."
            },
            {
              "note_id": "FCT_0203",
              "exact_quote": "When the increment operator is used as a prefix (++x), x is incremented first and the new value is used in the expression."
            }
          ],
          "payload": {
            "type": "table",
            "title": "Increment Operator Behavior",
            "headers": [
              "Form",
              "Evaluation Order",
              "Result Used in Expression"
            ],
            "rows": [
              [
                "Postfix (x++)",
                "Use current value, then increment",
                "Current value"
              ],
              [
                "Prefix (++x)",
                "Increment first, then use",
                "New incremented value"
              ]
            ]
          }
        }
